"""
Recreates all transformations from preprocess_hist() FROM (inclusive of)
the /4 downsampling resize step to the final padded output.

This is the second half of the pipeline — it takes the outputs of
preprocess_hist_up_to_resize.py (rotated_hist, rotated_region00) as inputs.

Pipeline:
  1.  /4 resize (downsampling)
  2.  Bounding box detection around prostate mask
  3.  Crop image to bounding box
  4.  Compute offsets (padding margins around crop)
  5.  Call transformAndSaveRegion for region00, 01, 09, 10
  6.  Build final zero-padded canvas and place crop into it
  7.  Save final image
"""

import cv2
import numpy as np
import os


def preprocess_hist_from_resize(
    rotated_hist: np.ndarray,
    rotated_region00: np.ndarray,
    output_path: str,
    case: str,
    slice_name: str,
    slice_entry: dict,
    theta: float,
    transform_and_save_region_fn=None,
) -> np.ndarray:
    """
    Reproduce the ProsRegNet preprocess_hist pipeline FROM (inclusive of)
    the /4 resize step through to the final saved image.

    Parameters
    ----------
    rotated_hist : np.ndarray
        Padded, rotated histology image — output of preprocess_hist_up_to_resize.
    rotated_region00 : np.ndarray
        Padded, rotated prostate mask — output of preprocess_hist_up_to_resize.
    output_path : str
        Destination directory (pre_process_moving_dest in original code).
    case : str
        Case identifier string.
    slice_name : str
        Slice key string (e.g. 'slice_001').
    slice_entry : dict
        The moving_dict[slice] entry for this slice.
    theta : float
        The rotation angle that was applied (theta = -rotation_angle).
        Passed through to transformAndSaveRegion.
    transform_and_save_region_fn : callable | None
        The transformAndSaveRegion function from your codebase.
        Signature must match:
            fn(dest, case, slice, s, region_name,
               theta, dH, dW, h, w, x, y, x_offset, y_offset)
        If None, the region saving step is skipped with a warning.

    Returns
    -------
    padHist : np.ndarray
        The final padded, cropped histology image (what gets written to disk).
    """

    # ------------------------------------------------------------------
    # Step 1 — /4 resize (downsampling)
    #           Note: dH uses axis-1 (width), dW uses axis-0 (height).
    #           cv2.resize takes (width, height) = (dH, dW) — matching original.
    # ------------------------------------------------------------------
    dH = int(rotated_hist.shape[1] / 4)
    dW = int(rotated_hist.shape[0] / 4)

    rotated_hist     = cv2.resize(rotated_hist,     (dH, dW), interpolation=cv2.INTER_CUBIC)
    rotated_region00 = cv2.resize(rotated_region00, (dH, dW), interpolation=cv2.INTER_CUBIC)

    print(f"[1] After /4 resize — image : {rotated_hist.shape}  mask : {rotated_region00.shape}")
    print(f"    dH (width)  = {dH}  |  dW (height) = {dW}")

    # ------------------------------------------------------------------
    # Step 2 — Bounding box around the prostate mask
    #           argwhere finds non-zero pixels in channel 0,
    #           fliplr converts (row, col) → (x, y),
    #           boundingRect returns (x, y, w, h) in OpenCV convention.
    #
    #  ⚠ Variable name collision in original code:
    #     cv2.boundingRect returns (x, y, w, h)
    #     but the original unpacks as:  y, x, h, w = cv2.boundingRect(points)
    #     i.e. the return values are assigned in swapped order.
    #     This is preserved exactly below so cropping behaviour is identical.
    # ------------------------------------------------------------------
    points = np.argwhere(rotated_region00[:, :, 0] != 0)   # (row, col) pairs
    points = np.fliplr(points)                              # → (x, y) / (col, row)

    # Original unpacking:  y, x, h, w = cv2.boundingRect(points)
    # cv2.boundingRect returns: (x, y, width, height)
    # So after the swap:   y=rect_x, x=rect_y, h=rect_w, w=rect_h
    rect = cv2.boundingRect(points)          # (rect_x, rect_y, rect_w, rect_h)
    y, x, h, w = rect                        # swapped assignment — matches original

    print(f"[2] Bounding rect (swapped) — x={x}  y={y}  w={w}  h={h}")

    # ------------------------------------------------------------------
    # Step 3 — Crop image to bounding box
    # ------------------------------------------------------------------
    crop = rotated_hist[x:x + w, y:y + h, :]
    print(f"[3] Crop shape : {crop.shape}")

    # ------------------------------------------------------------------
    # Step 4 — Compute padding offsets
    #           Both branches produce the same x_offset formula;
    #           only y_offset differs slightly (0.15 vs 0.20).
    # ------------------------------------------------------------------
    if h > w:
        y_offset = int(h * 0.15)
    else:
        y_offset = int(h * 0.20)

    x_offset = int((h - w + 2 * y_offset) / 2)

    print(f"[4] Offsets — x_offset={x_offset}  y_offset={y_offset}")

    # ------------------------------------------------------------------
    # Step 5 — Save sub-regions via transformAndSaveRegion
    # ------------------------------------------------------------------
    regions_to_save = ['region00', 'region01', 'region10', 'region09']

    if transform_and_save_region_fn is not None:
        for region_name in regions_to_save:
            transform_and_save_region_fn(
                output_path, case, slice_name, slice_entry,
                region_name,
                theta, dH, dW, h, w, x, y, x_offset, y_offset,
            )
        print(f"[5] transformAndSaveRegion called for: {regions_to_save}")
    else:
        print(f"[5] WARNING: transform_and_save_region_fn not provided — "
              f"skipping region saves for: {regions_to_save}")

    # ------------------------------------------------------------------
    # Step 6 — Build final padded canvas and place crop
    #           Canvas size uses updated h/w (after adding offsets).
    #           Note original updates h and w in-place after offset calc.
    # ------------------------------------------------------------------
    h_padded = h + 2 * y_offset
    w_padded = w + 2 * x_offset

    padHist = np.zeros((w_padded, h_padded, 3))
    padHist[x_offset: crop.shape[0] + x_offset,
            y_offset: crop.shape[1] + y_offset, :] = crop

    print(f"[6] Final padded canvas : {padHist.shape}")

    # ------------------------------------------------------------------
    # Step 7 — Save final image
    # ------------------------------------------------------------------
    os.makedirs(output_path, exist_ok=True)
    out_filename = os.path.join(
        output_path,
        f"hist_{case}_{slice_name}.png"
    )
    cv2.imwrite(out_filename, padHist)
    print(f"[7] Saved final image → {out_filename}")

    return padHist


# ----------------------------------------------------------------------
# Full pipeline convenience wrapper
# Chains preprocess_hist_up_to_resize → preprocess_hist_from_resize
# ----------------------------------------------------------------------
def run_full_pipeline(
    image_path: str,
    mask_path: str,
    output_path: str,
    case: str,
    slice_name: str,
    slice_entry: dict,
    flip: bool = False,
    rotation_angle: float = 0.0,
    transform_and_save_region_fn=None,
) -> np.ndarray:
    """
    Runs the complete preprocess_hist pipeline by chaining both halves.

    Parameters mirror preprocess_hist_up_to_resize + preprocess_hist_from_resize.
    """
    from preprocess_hist_up_to_resize import preprocess_hist_up_to_resize

    theta = -rotation_angle

    print("=== PHASE 1 : up to (exclusive of) /4 resize ===")
    rotated_hist, rotated_region00 = preprocess_hist_up_to_resize(
        image_path=image_path,
        mask_path=mask_path,
        flip=flip,
        rotation_angle=rotation_angle,
        save_path=None,
    )

    print("\n=== PHASE 2 : from /4 resize to final output ===")
    padHist = preprocess_hist_from_resize(
        rotated_hist=rotated_hist,
        rotated_region00=rotated_region00,
        output_path=output_path,
        case=case,
        slice_name=slice_name,
        slice_entry=slice_entry,
        theta=theta,
        transform_and_save_region_fn=transform_and_save_region_fn,
    )

    return padHist


